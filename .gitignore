# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Poetry virtual environment (if created in project directory)
.env/
.venv/

# VSCode settings (optional)
.vscode/

# PyInstaller build files
build/
dist/
*.spec

# Distribution / packaging
*.egg-info/
*.egg
*.whl
*.tar.gz
.eggs/
pip-wheel-metadata/

# Installer logs
pip-log.txt
poetry.lock

# Pytest
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# MacOS & Linux file cruft
.DS_Store
Thumbs.db
*.swp

# Pycharm & IDE config (optional)
.idea/

# MyPy and coverage
.mypy_cache/
.coverage.*
.cache/